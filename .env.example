# ============================================================
# DreamCatcher — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=dreamcatcher
POSTGRES_PASSWORD=dreamcatcher_dev_password
POSTGRES_DB=dreamcatcher
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Application Database URL ---
# Used by SQLAlchemy / Alembic
DATABASE_URL=postgresql+psycopg2://dreamcatcher:dreamcatcher_dev_password@localhost:5432/dreamcatcher

# For async SQLAlchemy (asyncpg driver):
# ASYNC_DATABASE_URL=postgresql+asyncpg://dreamcatcher:dreamcatcher_dev_password@localhost:5432/dreamcatcher

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- pgvector ---
# Embedding dimension — must match the model you use.
# 1536 = OpenAI ada-002 compatible
# 768  = BERT / sentence-transformers (768-dim)
# 384  = sentence-transformers (all-MiniLM-L6-v2)
VECTOR_DIM=1536

# --- Future: Google Cloud ---
# GCP_PROJECT_ID=
# GCP_REGION=asia-south1
# CLOUD_SQL_INSTANCE=
# GCS_BUCKET_NAME=
